{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ronda-one",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ronda-one-db",
      "database_id": "COLE_AQUI_O_ID_REAL"
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/ronda",
      "/ronda/*"
    ],
    "not_found_handling": "404-page"
  },

  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },

  "observability": {
    "enabled": true
  }
}
