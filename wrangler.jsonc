{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ronda-one",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",
  "ai": {
    "binding": "AI"
  },

  // Antes do deploy definitivo, adicione aqui o bloco d1_databases
  // usando o Database ID real. Veja CONFIGURAR-D1.txt.

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/ronda",
      "/ronda/*"
    ],
    "not_found_handling": "404-page"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
