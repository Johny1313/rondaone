{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rondaone",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ronda-one-db",
      "database_id": "25c28d56-093f-476a-9faa-860f24d4c4cd"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ROUND_JOBS_QUEUE",
        "queue": "ronda-one-round-jobs"
      },
      {
        "binding": "INTELLIGENT_JOBS_QUEUE",
        "queue": "ronda-one-intelligent-jobs"
      },
      {
        "binding": "ARTICLE_READ_QUEUE",
        "queue": "ronda-one-article-read"
      },
      {
        "binding": "CAROUSEL_AI_QUEUE",
        "queue": "ronda-one-carousel-ai"
      }
    ],
    "consumers": [
      {
        "queue": "ronda-one-round-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "dead_letter_queue": "ronda-one-jobs-dlq",
        "max_concurrency": 1
      },
      {
        "queue": "ronda-one-intelligent-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "ronda-one-jobs-dlq",
        "max_concurrency": 2
      },
      {
        "queue": "ronda-one-article-read",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "ronda-one-article-read-dlq",
        "max_concurrency": 3
      },
      {
        "queue": "ronda-one-carousel-ai",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "ronda-one-carousel-ai-dlq",
        "max_concurrency": 2
      }
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/login.js",
      "/login.css",
      "/access-client.js",
      "/admin/",
      "/design/",
      "/projects/",
      "/ronda",
      "/ronda/",
      "/ronda/index.html"
    ],
    "not_found_handling": "404-page"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "browser": {
    "binding": "BROWSER"
  }
}
